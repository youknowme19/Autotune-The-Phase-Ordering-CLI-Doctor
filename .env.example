# Autotune Configuration Environment Variables

# Compiler and LLVM settings
AUTOTUNE_CLANG_PATH=/usr/bin/clang
AUTOTUNE_OPT_PATH=/opt/homebrew/opt/llvm/bin/opt
AUTOTUNE_OPT_LEVEL=-O3

# Optimization Search Settings
AUTOTUNE_POPULATION_SIZE=20
AUTOTUNE_GENERATIONS=40
AUTOTUNE_TIMEOUT=5.0
AUTOTUNE_BENCHMARK_REPETITIONS=10
AUTOTUNE_NOISE_THRESHOLD=0.05
AUTOTUNE_RANDOM_SEED=42

# LLM Provider Configuration
# Supported providers: mock, openai, anthropic, custom
AUTOTUNE_LLM_PROVIDER=mock
AUTOTUNE_LLM_MODEL=gpt-4-turbo
AUTOTUNE_LLM_API_KEY=your_api_key_here

# Measurement Backend Configuration
# Supported backends: auto, macos_timing, linux_perf
AUTOTUNE_MEASUREMENT_BACKEND=auto
